{% extends 'base.html' %}

{% block title %}Inicio - Carta Virtual Cuba{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-4">Bienvenido a Carta Virtual Cuba</h1>
            <p class="lead mb-4">
                Sistema de menús digitales para restaurantes. Convierte tu menú en una experiencia digital.
            </p>
            <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                <a href="{% url 'login' %}" class="btn btn-primary btn-lg px-4">
                    <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                </a>
                <a href="{% url 'registro' %}" class="btn btn-success btn-lg px-4">
                    <i class="fas fa-user-plus"></i> Registrarse
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
